# Đổi tên file này thành ".env" (hoặc để "Tao giong + Render Ep01.command" tự tạo), rồi điền 2 dòng dưới.
# 1) API key: elevenlabs.io → Settings (góc trái dưới) → API Keys → Create
ELEVENLABS_API_KEY=dien_api_key_vao_day
# 2) Voice ID của giọng tiếng Việt bạn chọn: elevenlabs.io → Voices → chọn giọng → bấm "ID" để copy
ELEVENLABS_VOICE_ID=dien_voice_id_vao_day
# Tuỳ chọn: model (eleven_multilingual_v2 ổn định nhất cho tiếng Việt) và tốc độ đọc (0.7–1.2)
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_SPEED=1
